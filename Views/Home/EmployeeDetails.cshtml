@{
}
@{
    ViewData["Title"] = "Employee Details";
}

<h2>Employee Details</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Salary</th>
            <th>Address</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var person in ViewBag.People)
        {
            <tr>
                <td>@person.Name</td>
                <td>@person.Age</td>
                <td>@person.Salary</td>
                <td>@person.Address</td>
            </tr>
        }
    </tbody>
</table>
<a asp-controller="Home" asp-action="EmployeeDetails" class="btn btn-primary">
    View Details
</a>