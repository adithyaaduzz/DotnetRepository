@{
}
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3">

@foreach (var person in ViewBag.people)
{
    
        <div class="col mb-4">
            <div class="card" style="width: 18rem;">
                <div class="card-body">
                    <h5 class="card-title">@person.Name</h5>
                    <p class="card-text">Age: @person.Age</p>
                    <p class="card-text">Salary: @person.Salary</p>
                    <p class="card-text">Address: @person.Address</p>
                    <a asp-controller="Home" asp-action="Employee" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>
}
</div>